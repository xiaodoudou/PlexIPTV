# See Dockerfile: node:carbon-alpine was Node 8 and is long past end of life.
FROM node:26-alpine

WORKDIR /opt/PlexIPTV

COPY package*.json ./

RUN npm ci --omit=dev && npm cache clean --force

COPY . .

RUN sed -i 's/iptv.m3u8/config\/iptv.m3u8/g' template.json \
 && mkdir -p ./config ./logs \
 && chown -R node:node /opt/PlexIPTV

VOLUME ["/opt/PlexIPTV/config"]

USER node

EXPOSE 1234

CMD [ "npm", "run", "start:docker" ]
