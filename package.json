{
  "name": "plexiptv",
  "version": "1.5.0",
  "description": "Emulate Silicondust device for Plex by providing IPTV stream",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "start:docker": "node src/index.js -s ./config/settings.json",
    "start": "node src/index.js",
    "debug": "set DEBUG=plexiptv:* & node src/index.js",
    "debug:full": "set DEBUG=* & node src/index.js",
    "clean:build:ps": "rmdir /Q /S build",
    "clean:build:sh": "rm -rf build",
    "docker": "run-s docker:build docker:start",
    "docker:build": "docker build -t plexiptv .",
    "docker:start": "docker run --rm -p 12345:1234 --volume=c:/Users/Public/plexiptv:/opt/PlexIPTV/config plexiptv",
    "build:win:x64": "pkg src/index.js --targets node26-win-x64 -o build/PlexIPTV.win.x64.exe",
    "build:macos:x64": "pkg src/index.js --targets node26-macos-x64 -o build/PlexIPTV.macos.x64",
    "build:linux:x64": "pkg src/index.js --targets node26-linux-x64 -o build/PlexIPTV.linux-x64",
    "build:linux:arm64": "pkg src/index.js --targets node26-linux-arm64 --no-bytecode --public -o build/PlexIPTV.linux-arm64",
    "build:macos:arm64": "pkg src/index.js --targets node26-macos-arm64 --no-bytecode --public -o build/PlexIPTV.macos.arm64",
    "build": "run-s build:win:x64 build:macos:x64 build:linux:x64 build:linux:arm64"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "args": "^5.0.3",
    "colors": "1.4.0",
    "debug": "^4.4.3",
    "express": "^4.22.3",
    "log-rotate": "^0.2.8",
    "md5": "^2.3.0",
    "q": "^1.5.1",
    "stack-trace": "0.0.10"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "npm-run-all": "^4.1.5"
  }
}
